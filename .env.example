# Core
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API in production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the API (Vercel/Render/Nginx = 1)
TRUST_PROXY=1
ADMIN_BASE_URL=http://localhost:5174

# Database and cache
DATABASE_URL=mongodb://orvix:orvix_dev_password@localhost:27017/orvix?authSource=admin&replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Auth (JWT_SECRET is REQUIRED in production: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# Storage
STORAGE_PROVIDER=local
UPLOAD_ROOT=uploads
MAX_UPLOAD_MB=8
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider abstraction
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
VISION_PROVIDER=
VISION_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=
SPEECH_PROVIDER=
SPEECH_API_KEY=

# Product and barcode data providers
BARCODE_PROVIDER=
BARCODE_API_KEY=
NUTRITION_DATA_PROVIDER=
NUTRITION_DATA_API_KEY=

# Notifications and health integrations
PUSH_PROVIDER=
PUSH_API_KEY=
HEALTHKIT_TEAM_ID=
HEALTH_CONNECT_CLIENT_ID=

# Admin bootstrap
ADMIN_EMAIL=admin@orvix.local
# In production the seed refuses this placeholder: use a unique password of 12+ characters.
ADMIN_PASSWORD=change-me-before-production
